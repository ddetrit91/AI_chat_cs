# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Обязательно: GEMINI_MODEL=имя_модели (см. https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-3.5-flash-lite

# Запасные модели через запятую при 503/404 (необязательно)
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

PORT=3001
